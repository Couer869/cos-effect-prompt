{
  "manifestVersion": 5,
  "id": "com.couer869.coseffectprompt",
  "name": "COS 后期提示词生成器",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "24.0.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "cosPromptPanel",
      "label": { "default": "COS 提示词" },
      "minimumSize": { "width": 260, "height": 380 },
      "maximumSize": { "width": 1600, "height": 1600 },
      "preferredDockedSize": { "width": 330, "height": 620 },
      "preferredFloatingSize": { "width": 380, "height": 660 }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "network": { "domains": "all" },
    "allowCodeGenerationFromStrings": true
  }
}
